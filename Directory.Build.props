<Project>
  <PropertyGroup>
    <!-- The library and the tests build for both; the tools pick net10.0. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Filip Navara</Authors>
    <Copyright>Copyright (c) 2026 The Tarjamot Authors</Copyright>
    <RepositoryUrl>https://github.com/filipnavara/Tarjamot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/filipnavara/Tarjamot</PackageProjectUrl>
  </PropertyGroup>
</Project>
